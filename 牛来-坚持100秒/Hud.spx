// Hud —— 常驻 HUD 精灵
//
// 背景：spx 3.3.0 runner 不支持编辑器的 monitor 控件，数字造型方案
//      又受渲染缩放影响不可靠 —— 唯一确认可用的文字渲染是 say 气泡。
//      本精灵只负责「持续显示剩余时间与得分」，不含任何游戏逻辑。
//
// spx 没有可用的数字→字符串 API（strconv 不可用），
// 所以用「一位数字 → 字符串常量」的查表函数拼出读数。

// d1 一位数字 → 字符串
func d1(v int) string {
	if v == 0 {
		return "0"
	} else if v == 1 {
		return "1"
	} else if v == 2 {
		return "2"
	} else if v == 3 {
		return "3"
	} else if v == 4 {
		return "4"
	} else if v == 5 {
		return "5"
	} else if v == 6 {
		return "6"
	} else if v == 7 {
		return "7"
	} else if v == 8 {
		return "8"
	}
	return "9"
}

// d2 两位数字 → 字符串
func d2(v int) string {
	if v < 0 {
		return "00"
	}
	if v > 99 {
		v = 99
	}
	t := v / 10
	return d1(t) + d1(v - t * 10)
}

// d3 三位数字 → 字符串
func d3(v int) string {
	if v < 0 {
		return "0"
	}
	h := v / 100
	if h > 9 {
		h = 9
	}
	return d1(h) + d2(v - h * 100)
}

onStart => {
	for {
		// say 会阻塞到时长结束，所以等待要短，保证气泡几乎不间断
		if finished {
			// 结算画面：常驻重试提示，直到按 R 重开
			if won {
				say "通关！按 R 键再来一局", 1.2
			} else {
				say "失败！按 R 键再来一局", 1.2
			}
		} else {
			say "剩余 " + d2(remain) + " 秒  得分 " + d3(score), 1.2
		}
		wait 0.05
	}
}
